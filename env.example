# Domaine public, sans chemin final. Remplacer newsletter.example.com.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=newsletter.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://newsletter.example.com
SITE_URL=https://newsletter.example.com

# À remplacer par une valeur longue et aléatoire en production
DJANGO_SECRET_KEY=change-me-in-production

# SMTP de production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=newsletter@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=newsletter@example.com

# Docker et HTTPS derrière Nginx
IMAGE_TAG=latest
APP_PORT=8004
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
# Commencer à 1, puis passer à 31536000 après validation complète de HTTPS.
DJANGO_SECURE_HSTS_SECONDS=1
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Activé automatiquement par docker-compose.yml après collectstatic.
DJANGO_STATIC_MANIFEST=1